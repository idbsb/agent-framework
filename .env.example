# Local defaults. Export these variables; the server does not auto-load this file.
P1_ENV=local
P1_CLOSURE_WRITES=0
P1_CLOSURE_DB=data/p1_closure.sqlite3
# Production values must be set in Render, not Vercel or Git.
# P1_ENV=production
# P1_STORAGE_DIR=/var/data/p1
# P1_CLOSURE_DB=/var/data/p1/closure.sqlite3
# P1_ADMIN_TOKEN=<random secret, at least 32 ASCII characters>
# P1_ADMIN_NAME=<responsible administrator>
# CORS_ORIGINS=https://<formal-vercel-domain>
# P1_INITIALIZE_DB=0
